    <string name="adb_start_shizuku_cmd">adb shell sh /sdcard/Android/data/moe.shizuku.privileged.api/start.sh</string>
    <string name="how_it_works_point4_title">ADB / Shizuku Mode</string>
    <string name="how_it_works_point4_desc">Enable Shizuku to set default apps instantly with a single tap.</string>
