    <!-- How it works dialog -->
    <string name="how_it_works_intro">Defaulty makes it easy to view and manage default apps while adhering to Android\'s security architecture.</string>
    <string name="how_it_works_point1_title">System security model</string>
    <string name="how_it_works_point1_desc">Default apps are managed strictly by Android. No third-party app can change your defaults without your consent.</string>
    <string name="how_it_works_point2_title">Native confirmation prompts</string>
    <string name="how_it_works_point2_desc">When changing a default, Android displays its official dialog so you remain in full control.</string>
    <string name="how_it_works_point3_title">Live system discovery</string>
    <string name="how_it_works_point3_desc">Defaulty queries system RoleManager and App Link APIs in real time to reflect your latest settings accurately.</string>

    <!-- Privacy dialog -->
    <string name="privacy_intro">Defaulty is built with a strict privacy-first approach to keep your device and data completely safe.</string>
    <string name="privacy_point1_title">Zero internet access</string>
    <string name="privacy_point1_desc">Defaulty does not request internet permission. Your data never leaves your device under any circumstance.</string>
    <string name="privacy_point2_title">No trackers or telemetry</string>
    <string name="privacy_point2_desc">No analytics SDKs, advertising IDs, crashlytics, or third-party tracking tools are present.</string>
    <string name="privacy_point3_title">On-device storage only</string>
    <string name="privacy_point3_desc">Preferences such as your theme choice are stored locally on your device using DataStore.</string>
    <string name="privacy_point4_title">Official Android APIs</string>
    <string name="privacy_point4_desc">All app and role queries use standard public Android framework APIs with zero root access needed.</string>

